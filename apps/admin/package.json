{
  "name": "@rsd-sync/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "tsc -p tsconfig.lib.json && next build",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@rsd-sync/configuration": "workspace:*",
    "@rsd-sync/contracts": "workspace:*",
    "@rsd-sync/shared": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.5"
  }
}
