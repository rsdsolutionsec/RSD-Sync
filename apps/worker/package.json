    "start": "node dist/index.js"
  },
  "dependencies": {
    "@rsd-sync/automation-core": "workspace:*",
    "@rsd-sync/configuration": "workspace:*",
    "@rsd-sync/observability": "workspace:*",
    "@rsd-sync/queue": "workspace:*",
    "@rsd-sync/shared": "workspace:*",
    "bullmq": "^6.7.7",
    "ioredis": "^6.0.0"
  }
}
