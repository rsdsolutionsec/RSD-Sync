# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

FROM base AS builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/admin/package.json apps/admin/tsconfig.json apps/admin/tsconfig.lib.json apps/admin/next.config.ts apps/admin/postcss.config.mjs apps/admin/vercel.json ./apps/admin/
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY apps/admin/src ./apps/admin/src
RUN pnpm --filter @rsd-sync/admin... build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/admin ./apps/admin
USER node
EXPOSE 3000
CMD ["npm", "--prefix", "apps/admin", "run", "start"]
