# ==============================================================================
# RSD Sync — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real production credentials to version control.
# NEVER point local development or test runs to SUMAK production databases.
# ==============================================================================

# --- Runtime & Node ---
NODE_ENV=development
LOG_LEVEL=info
PLATFORM_NAME=rsd-sync

# --- Fastify API ---
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://127.0.0.1:4000
# Optional shared backend key for server-to-server calls (admin BFF -> api)
ADMIN_API_KEY=

# --- BullMQ Worker ---
WORKER_CONCURRENCY=5

# --- Next.js Admin Panel (apps/admin -> Vercel) ---
ADMIN_PORT=3000
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Comma-separated allowlist of authorized administrator emails (server-side only)
ADMIN_EMAILS=admin@rsdsolutions.com
# Local-dev-only passcode when Supabase Auth is not yet configured (ignored in production)
DEV_ADMIN_ACCESS_KEY=

# --- Redis / BullMQ (Local Docker Service) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# --- PostgreSQL Local Database (Docker, isolated port 54332) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54332
POSTGRES_USER=rsd_sync
POSTGRES_PASSWORD=rsd_sync_dev_password
POSTGRES_DB=rsd_sync_dev
DATABASE_URL=postgresql://rsd_sync:rsd_sync_dev_password@127.0.0.1:54332/rsd_sync_dev

# --- RSD Sync Dedicated Supabase Infrastructure (NEVER use SUMAK credentials) ---
# Set DATABASE_TARGET=auto|local|supabase
DATABASE_TARGET=auto
# Pooled or primary Postgres connection string for RSD Sync Supabase
RSD_DATABASE_URL=
# Direct connection string for running SQL migrations against RSD Sync Supabase
RSD_DATABASE_DIRECT_URL=
# Backend Supabase project URL & keys (service_role NEVER allowed in browser/NEXT_PUBLIC)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase values for apps/admin browser Auth client (non-secret only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Security & Cryptography ---
# Local placeholder only. Generate a real 32+ byte random key for staging/production.
ENCRYPTION_MASTER_KEY=dev-only-32-byte-master-key-change-me
JWT_SECRET=dev-only-jwt-secret-minimum-32-characters-long
WEBHOOK_SIGNATURE_TIMEOUT_MS=300000

# --- AI Engine (Provider-Agnostic, Phase 5+) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
AI_DAILY_COST_LIMIT_USD=10.00

# --- WhatsApp Cloud API Adapter (Phase 6+) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- SUMAK Client Adapter (Isolated Tenant Integration, Phase 4 & Phase 8) ---
# IMPORTANT: Do NOT set production credentials during local Phase 0-3 development.
SUMAK_ADAPTER_MODE=readonly
SUMAK_SUPABASE_URL=
SUMAK_SUPABASE_ANON_KEY=
SUMAK_API_BASE_URL=
SUMAK_WEBHOOK_SECRET=
