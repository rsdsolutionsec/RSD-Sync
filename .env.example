# ==============================================================================
# RSD Sync — Local Development Environment Template
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real production credentials to version control.
# NEVER point local development or test runs to SUMAK production databases.
# ==============================================================================

# --- Runtime & Node ---
NODE_ENV=development
LOG_LEVEL=info
PLATFORM_NAME=rsd-sync

# --- Fastify API (Phase 1+) ---
API_HOST=127.0.0.1
API_PORT=4000

# --- BullMQ Worker (Phase 1+) ---
WORKER_CONCURRENCY=5

# --- Next.js Admin Panel (Phase 7+) ---
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# --- Redis / BullMQ (Local Docker Service) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# --- PostgreSQL / pgvector Local Database (RSD Sync Dev Only) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_USER=rsd_sync
POSTGRES_PASSWORD=rsd_sync_dev_password
POSTGRES_DB=rsd_sync_dev
DATABASE_URL=postgresql://rsd_sync:rsd_sync_dev_password@127.0.0.1:54322/rsd_sync_dev

# --- Security & Cryptography ---
# Local placeholder only. Generate a real 32-byte key for staging/production.
ENCRYPTION_MASTER_KEY=dev-only-32-byte-master-key-change-me
JWT_SECRET=dev-only-jwt-secret-minimum-32-characters-long
WEBHOOK_SIGNATURE_TIMEOUT_MS=300000

# --- AI Engine (Provider-Agnostic, Phase 5+) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
AI_DAILY_COST_LIMIT_USD=10.00

# --- WhatsApp Cloud API Adapter (Phase 6+) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- SUMAK Client Adapter (Isolated Tenant Integration, Phase 4 & Phase 8) ---
# IMPORTANT: Do NOT set production credentials during local Phase 0-3 development.
SUMAK_ADAPTER_MODE=readonly
SUMAK_SUPABASE_URL=
SUMAK_SUPABASE_ANON_KEY=
SUMAK_API_BASE_URL=
SUMAK_WEBHOOK_SECRET=
